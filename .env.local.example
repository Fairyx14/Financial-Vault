# Copy this file to .env.local and fill in both values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API (or "Connect")
# The anon / publishable key is safe to use in the browser.
# NEVER put the service_role (secret) key here or anywhere in the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
